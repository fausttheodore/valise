{
  "name": "valise",
  "version": "0.1.0",
  "description": "Browser side-panel reading assistant: read pages, ask about selections, chat with your own models.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/licenses.mjs && vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "mock": "node tests/mock-server.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.html package.json public/manifest.json"
  },
  "license": "MIT",
  "dependencies": {
    "defuddle": "^0.19.4",
    "dompurify": "^3.4.16",
    "eventsource-parser": "^4.1.1",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
